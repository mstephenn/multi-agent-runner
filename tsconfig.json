{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@mar/*": ["packages/*/src/index.ts"] }
  },
  "include": ["packages/*/src", "packages/*/test"]
}
